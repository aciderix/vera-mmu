{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VERA-MMU",
  "version": "0.1.0-4",
  "identifier": "im.aciderix.vera-mmu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "VERA-MMU · Contrôle local", "width": 1260, "height": 820, "minWidth": 880, "minHeight": 660 }],
    "security": { "capabilities": ["desktop-main"] }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/vmmu-desktop-bridge"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
